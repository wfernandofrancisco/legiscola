APP_NAME=Legiscola
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SESSION_DOMAIN=legiscola.local
# Portal multi-tenant (SetTenantContext): o host deve ser {slug}.{APP_DOMAIN}
# Ex.: tenants.slug = acme → http://acme.lvh.me:8000 com APP_DOMAIN=lvh.me
# ou http://acme.legiscola.local:8000 com APP_DOMAIN=legiscola.local (Hosts → 127.0.0.1)
APP_DOMAIN=

# Portal público — marca Legiscola (logo em public/, ex.: img/legiscola.svg) e contato do dono da plataforma
PLATFORM_LOGO_PATH=img/legiscola.svg
# PLATFORM_WEBSITE_URL=https://legiscola.com.br
PLATFORM_OWNER_LABEL=Legiscola — plataforma
# PLATFORM_OWNER_EMAIL=contato@seudominio.com
# PLATFORM_OWNER_PHONE=+5511999999999

# Locale e Timezone
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=desenvolve_city
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Segundos: deve cobrir jobs longos (geocodificacao). Padrao 90000 = 25h.
DB_QUEUE_RETRY_AFTER=90000

# Nominatim (geocodificacao). Politica publica: intervalo >= 1s entre requisicoes.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL="${MAIL_FROM_ADDRESS}"
# NOMINATIM_USER_AGENT="DesenvolveCity/1.0 (+https://seu-dominio)"
NOMINATIM_MIN_REQUEST_INTERVAL_MS=1100
NOMINATIM_MAX_RETRIES=6

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun (optional)
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Desenvolvimento Vite: se public/hot tiver URL inválida, apague o ficheiro e reinicie `npm run dev`.
# Com host 127.0.0.1 + origin no vite.config, o Laravel injeta http://127.0.0.1:5173 nos assets.
# Se o browser estiver noutra máquina na rede, use o IP do PC em vez de 127.0.0.1 no vite.config (origin + host).

# Cloudflare Turnstile (opcional em local). Dashboard: https://dash.cloudflare.com/ → Turnstile → Add widget.
# Chaves de teste: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
